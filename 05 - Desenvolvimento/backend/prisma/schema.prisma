// Mesaí — Cantina 67
// Modelo de dados derivado da Especificação de Requisitos v0.2 e da Documentação do Projeto.
// Valores monetários usam Decimal (RNF-08) — nunca ponto flutuante.
// empresaId prepara a evolução multiempresa (RNF-10), sem uso no MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  COLABORADOR
  GERENTE
}

enum OrderStatus {
  RECEBIDO
  EM_PREPARACAO
  EM_TRANSPORTE
  ENTREGUE
  CANCELADO
}

enum PaymentMethod {
  PIX
  CREDITO
  DEBITO
  VALE_REFEICAO
  DINHEIRO
}

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String
  email        String   @unique
  passwordHash String
  cpf          String   @unique // apenas dígitos; imutável após cadastro (RN-10)
  cep          String
  number       String
  complement   String?
  reference    String?
  role         Role     @default(CLIENTE)
  isSeed       Boolean  @default(false) // Gerente padrão protegido (RN-07)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  cartItems          CartItem[]
  orders             Order[]
  unavailabilityLogs UnavailabilityLog[]
  statusEvents       OrderStatusEvent[]
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String? // LOGOUT | NOVO_LOGIN | INATIVIDADE | SENHA_REDEFINIDA

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // somente o hash SHA-256 é guardado
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model StoreConfig {
  id               Int      @id @default(1)
  empresaId        String   @default("cantina-67")
  storeName        String   @default("Cantina 67")
  address          String   @default("")
  deliveryFee      Decimal  @default(10.00) @db.Decimal(10, 2)
  estimatedMinutes Int      @default(45)
  updatedAt        DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  empresaId String    @default("cantina-67")
  name      String
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  dishes    Dish[]
}

model Dish {
  id              String    @id @default(uuid())
  empresaId       String    @default("cantina-67")
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  name            String
  description     String
  price           Decimal   @db.Decimal(10, 2)
  discountPercent Decimal?  @db.Decimal(5, 2) // null = sem desconto; quando houver, 0,1 a 100 (RN-12)
  photoUrl        String
  available       Boolean   @default(true)
  deletedAt       DateTime? // exclusão lógica (RN-05)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cartItems          CartItem[]
  orderItems         OrderItem[]
  unavailabilityLogs UnavailabilityLog[]
}

model UnavailabilityLog {
  id        String   @id @default(uuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  available Boolean // false = marcado indisponível; true = disponível de volta
  createdAt DateTime @default(now())
}

model CartItem {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId   String
  dish     Dish   @relation(fields: [dishId], references: [id])
  quantity Int

  @@unique([userId, dishId])
}

model Order {
  id                 String        @id @default(uuid())
  number             Int           @unique @default(autoincrement())
  empresaId          String        @default("cantina-67")
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  status             OrderStatus   @default(RECEBIDO)
  paymentMethod      PaymentMethod
  needsChange        Boolean       @default(false)
  cashAmount         Decimal?      @db.Decimal(10, 2)
  changeAmount       Decimal?      @db.Decimal(10, 2)
  itemsTotal         Decimal       @db.Decimal(10, 2)
  deliveryFee        Decimal       @db.Decimal(10, 2) // frete congelado (RN-03)
  total              Decimal       @db.Decimal(10, 2)
  deliveryCep        String
  deliveryNumber     String
  deliveryComplement String?
  deliveryReference  String?
  storeAddress       String
  estimatedMinutes   Int
  cancelReason       String?
  cancelledByRole    Role?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items  OrderItem[]
  events OrderStatusEvent[]

  @@index([userId])
  @@index([status])
}

// Cópia congelada dos dados comerciais no momento da finalização (RN-03)
model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId              String
  dish                Dish    @relation(fields: [dishId], references: [id])
  name                String
  unitPrice           Decimal @db.Decimal(10, 2)
  discountPercent     Decimal @default(0) @db.Decimal(5, 2)
  unitPriceDiscounted Decimal @db.Decimal(10, 2)
  quantity            Int
  subtotal            Decimal @db.Decimal(10, 2)
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  reason    String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}
