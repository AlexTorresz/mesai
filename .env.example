# Copie para ".env" (nesta pasta 06 - Docker E/OU na raiz do projeto) e troque os valores.
# Nunca envie o arquivo .env para o Git.

POSTGRES_DB=mesai
POSTGRES_USER=mesai
POSTGRES_PASSWORD=troque-esta-senha

# Gere um segredo longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

APP_PORT=8080
MAILPIT_PORT=8025
APP_URL=http://localhost:8080

INACTIVITY_MINUTES=30
RESET_TOKEN_MINUTES=30

# Gerente padrão criado pelo seed (RF-11)
SEED_GERENTE_EMAIL=gerente@cantina67.com.br
SEED_GERENTE_PASSWORD=Mesai@2026

# Dados de demonstração (cardápio + Colaborador + Cliente). Use false em produção.
SEED_DEMO=true
SEED_DEMO_PASSWORD=Mesai@2026

# true somente quando o sistema estiver atrás de HTTPS
COOKIE_SECURE=false
